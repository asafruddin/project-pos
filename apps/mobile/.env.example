# Copy to .env.local (gitignored) to override the API the app talks to.
# Default (no override): https://project-pos-api.vercel.app

# Local API from the Android emulator (host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3001
# Local API from a real device on the same Wi-Fi:
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001
