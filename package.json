{
  "name": "pos-apps",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:cashier": "turbo run dev --filter=@pos-apps/cashier",
    "dev:mobile": "turbo run build --filter=@pos-apps/mobile^... && pnpm --filter @pos-apps/mobile start",
    "dev:dashboard": "turbo run dev --filter=@pos-apps/dashboard",
    "dev:platform": "turbo run dev --filter=@pos-apps/platform",
    "dev:api": "turbo run dev --filter=@pos-apps/api",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.10.9",
    "typescript": "^5.8.2"
  }
}
