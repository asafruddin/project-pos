DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
PORT=3001
CORS_ORIGIN=http://localhost:3002,http://localhost:3000,http://localhost:3003
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Dashboard AI assistant (optional). Leave the key empty to hide "Asisten".
# AI_PROVIDER=google uses Gemini (default model gemini-flash-latest).
# AI_PROVIDER=openrouter needs AI_MODEL set to a tools-capable model (e.g. a ":free" one).
AI_PROVIDER=google
AI_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
AI_RATE_LIMIT_PER_MIN=10
